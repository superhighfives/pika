/* Basics */
"help.basics" = "مبانی";

/* Basics intro: what colour contrast is */
"help.basics.intro.1" = "کنتراست رنگ، تفاوت روشنایی میان متن و هر چیزی است که پشت آن قرار دارد. اگر این تفاوت کم باشد، واژه‌ها در پس‌زمینه محو می‌شوند. این مشکلی جدی برای افراد کم‌بینا یا دارای کوررنگی است و دیگران را هم گرفتار می‌کند؛ مثلاً هنگام خواندن گوشی زیر نور آفتاب یا لپ‌تاپی با روشنایی کم.";

/* Basics intro: accessibility guidelines */
"help.basics.intro.2" = "رهنمودهای دسترس‌پذیری حداقل سطح کنتراست را تعیین می‌کنند تا متن برای هرچه بیشتر افراد خوانا بماند. WCAG 2 استانداردی است که بیشتر رهنمودها و قوانین به آن ارجاع می‌دهند، و APCA روشی جدیدتر است که اندازه و ضخامت قلم را نیز در نظر می‌گیرد. بررسی در مراحل اولیه بسیار آسان‌تر از بازطراحی در آینده است.";

/* Basics intro: where Pika fits */
"help.basics.intro.3" = "اینجاست که Pika به کار می‌آید. پیش‌زمینه و پس‌زمینه را از هر جای صفحه‌نمایش بردارید، چه یک فایل طراحی باشد، چه یک وب‌سایت یا یک تصویر صفحه، و Pika بلافاصله کنتراست را همراه با رنگ‌ها در قالب مورد نیازتان و آمادهٔ کپی نشان می‌دهد.";

