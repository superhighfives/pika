/* Foreground and background */
"help.basics.pair.title" = "Foreground and background";

/* Foreground and background description */
"help.basics.pair" = "The foreground is text or an icon; the background is the surface behind it. Press [X] to swap them.";

/* Why check contrast */
"help.basics.contrast.title" = "Why check contrast";

/* Why check contrast description */
"help.basics.contrast" = "Low-contrast text is hard to read, especially with low vision, colour blindness or glare.";

/* WCAG and APCA */
"help.basics.standards.title" = "WCAG and APCA";

/* WCAG and APCA description */
"help.basics.standards" = "WCAG 2 gives a ratio (AA needs 4.5:1 for text). APCA gives an Lc value that accounts for size and weight, but isn’t a standard yet.";

/* Ways to pick a colour */
"help.basics.pickers.title" = "Ways to pick a colour";

