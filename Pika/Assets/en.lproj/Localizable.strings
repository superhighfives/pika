/* Basics */
"help.basics" = "Basics";

/* Basics intro: what colour contrast is */
"help.basics.intro.1" = "Colour contrast is the difference in lightness between text and whatever’s behind it. With too little, words blur into their background. That’s a real problem for people with low vision or colour blindness, and it catches everyone else too, like reading a phone in the sun or a laptop turned down low.";

/* Basics intro: accessibility guidelines */
"help.basics.intro.2" = "Accessibility guidelines set minimum contrast levels so text stays readable for as many people as possible. WCAG 2 is the standard most guidelines and laws point to, and APCA is a newer method that also weighs up font size and weight. Checking early is much easier than reworking a design later.";

/* Basics intro: where Pika fits */
"help.basics.intro.3" = "That’s where Pika comes in. Pick a foreground and background from anywhere on your screen, whether it’s a design file, a website or a screenshot, and Pika shows the contrast straight away, alongside the colours in the format you need, ready to copy.";

/* Expand the Basics intro */
"help.basics.intro.more" = "Read more";

/* Collapse the Basics intro */
