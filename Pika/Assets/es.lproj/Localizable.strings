/* Basics */
"help.basics" = "Conceptos básicos";

/* Basics intro: what colour contrast is */
"help.basics.intro.1" = "El contraste de color es la diferencia de luminosidad entre el texto y lo que hay detrás. Si es demasiado bajo, las palabras se confunden con el fondo. Es un problema real para las personas con baja visión o daltonismo, y también afecta a todos los demás, como al leer el móvil a pleno sol o en un portátil con el brillo al mínimo.";

/* Basics intro: accessibility guidelines */
"help.basics.intro.2" = "Las pautas de accesibilidad fijan niveles mínimos de contraste para que el texto sea legible para el mayor número de personas posible. WCAG 2 es el estándar al que remiten la mayoría de pautas y leyes, y APCA es un método más reciente que también tiene en cuenta el tamaño y el peso de la fuente. Comprobarlo desde el principio es mucho más fácil que rehacer un diseño después.";

/* Basics intro: where Pika fits */
"help.basics.intro.3" = "Ahí es donde entra Pika. Selecciona un primer plano y un segundo plano de cualquier parte de la pantalla, ya sea un archivo de diseño, un sitio web o una captura, y Pika te muestra el contraste al instante, junto con los colores en el formato que necesites, listos para copiar.";

/* Expand the Basics intro */
"help.basics.intro.more" = "Seguir leyendo";

/* Collapse the Basics intro */
"help.basics.intro.less" = "Mostrar menos";

/* Foreground and background */
"help.basics.pair.title" = "Primer plano y segundo plano";

/* Foreground and background description */
"help.basics.pair" = "El primer plano es texto o un icono; el segundo plano es la superficie que hay detrás. Pulsa [X] para intercambiarlos.";

/* Why check contrast */
"help.basics.contrast.title" = "Por qué comprobar el contraste";

/* Why check contrast description */
"help.basics.contrast" = "El texto con poco contraste es difícil de leer, sobre todo con baja visión, daltonismo o reflejos.";

/* WCAG and APCA */
"help.basics.standards.title" = "WCAG y APCA";

/* WCAG and APCA description */
"help.basics.standards" = "WCAG 2 da una proporción (AA requiere 4.5:1 para texto). APCA da un valor Lc que tiene en cuenta el tamaño y el peso, pero aún no es un estándar.";

/* Ways to pick a colour */
"help.basics.pickers.title" = "Formas de seleccionar un color";

/* Basic, Pro and system colour picker description */
"help.basics.pickers" = "El selector básico usa el muestreador de macOS. El Pro añade una lupa en tiempo real y necesita Grabación de pantalla. [⌘S] abre el panel de colores de macOS.";

/* Editing values */
"help.basics.editing.title" = "Editar valores";

/* Editing values description */
"help.basics.editing" = "Haz clic en un valor para escribir, arrastra o desplázate con dos dedos para ajustarlo, y pulsa [↑] o [↓] para ir paso a paso. [⌘Z] deshace.";

